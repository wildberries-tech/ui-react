.select {

    &__container {
        display: grid;
        font-family: var(--font-family-primary);
        font-style: normal;
        font-weight: 400;
        font-size: 16px;
        grid-row-gap: 6px;
    }

    &__label {
        color: #4e4e53;
        line-height: 20px;
        display: block;
    }
}
